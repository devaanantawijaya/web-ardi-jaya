---
import { Image } from 'astro:assets';
import { PROJECTS_DATA } from '../data/dbdummy';

const featuredProjects = PROJECTS_DATA.slice(0, 6);
---

<section
  id="portofolio"
  class="py-28 sm:py-36 bg-[#0E1116] text-white border-b border-white/10"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">

    <!-- Section Header -->
    <div
      class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-20 sm:mb-24 pb-8 border-b border-white/15"
    >
      <div>
        <span
          class="text-xs font-mono font-bold uppercase tracking-[0.35em] text-[#F26522] block mb-4"
        >
          Selected Portfolio
        </span>

        <h2
          class="text-3xl sm:text-5xl lg:text-6xl font-extrabold uppercase tracking-tight text-white font-sans"
        >
          Our Work
        </h2>
      </div>

      <p class="text-base sm:text-lg text-slate-400 font-light max-w-md leading-relaxed">
        From modern luxury villas to complex industrial facilities across Bali.
        Each project reflects our commitment to precision, timing, and
        uncompromised build quality.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">
      {featuredProjects.map((project) => (
        <article
          id={`featured-project-${project.slug}`}
          class="group flex flex-col cursor-pointer"
        >

          <!-- Image -->
          <a
            href={`/portfolio/${project.slug}`}
            class="block overflow-hidden rounded-none bg-slate-900 aspect-[16/11] relative mb-4"
          >
            <Image
              src={project.image}
              alt={project.title}
              width={1200}
              height={825}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
          </a>

          <!-- Title & Metadata -->
          <div class="flex items-start justify-between gap-4">
            <div>
              <div
                class="flex items-center gap-2 text-[11px] font-mono text-[#F26522] tracking-wider uppercase mb-1"
              >
                <span>{project.category}</span>
                <span class="text-slate-600">&bull;</span>
                <span class="text-slate-400">{project.location}</span>
              </div>

              <h3
                class="text-lg sm:text-xl font-bold tracking-tight text-white group-hover:text-[#F26522] transition-colors"
              >
                <a href={`/portfolio/${project.slug}`}>
                  {project.title}
                </a>
              </h3>
            </div>

            <a
              href={`/portfolio/${project.slug}`}
              class="w-9 h-9 rounded-none border border-white/20 flex items-center justify-center shrink-0 group-hover:border-[#F26522] group-hover:bg-[#F26522] transition-all duration-200 mt-1"
              aria-label={`View ${project.title}`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
              </svg>
            </a>
          </div>

        </article>
      ))}
    </div>

    <!-- View All -->
    <div class="mt-16 sm:mt-20 pt-10 border-t border-white/15 text-center">
      <a
        href="/portfolio"
        id="view-all-portfolio-btn"
        class="group inline-flex items-center justify-center gap-4 bg-white hover:bg-[#F26522] text-black hover:text-white px-9 sm:px-10 py-4.5 rounded-none text-xs uppercase tracking-[0.22em] font-bold transition-all duration-200 shadow-md"
      >
        <span>View All Completed Works</span>

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        >
          <path d="M7 7h10v10" />
          <path d="M7 17 17 7" />
        </svg>
      </a>
    </div>

  </div>
</section>