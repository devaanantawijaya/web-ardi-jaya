---

---

 <section
      class="relative min-h-[90vh] sm:min-h-screen flex items-center justify-center overflow-hidden bg-black text-white"
    >
      <!-- Background Image -->
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=2400&q=85"
          alt="Build Luxury Property in Bali"
          class="w-full h-full object-cover object-center scale-105"
          loading="eager"
          referrerpolicy="no-referrer"
        />

        <div class="absolute inset-0 bg-black/60 sm:bg-black/55 backdrop-blur-[0.5px]"></div>

        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/40"></div>
      </div>

      <!-- Hero Content -->
      <div
        class="relative z-10 max-w-6xl mx-auto px-6 sm:px-8 text-center pt-24 pb-16"
      >
        <span
          class="text-xs sm:text-sm font-mono font-bold uppercase tracking-[0.35em] text-[#E5A823] block mb-4 sm:mb-6"
        >
          BALI CONSTRUCTION
        </span>

        <h1
          class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold uppercase tracking-tight text-white leading-[0.96] mb-6 sm:mb-8 font-sans"
        >
          BUILD LUXURY<br />
          PROPERTY IN BALI<span class="text-[#E5A823]">.</span>
        </h1>

        <div
          class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm sm:text-base md:text-lg text-slate-200 font-light tracking-wide max-w-4xl mx-auto"
        >
          <span>Residential buildings & villas</span>
          <span class="hidden sm:inline text-[#E5A823]">&bull;</span>

          <span>Commercial premises</span>
          <span class="hidden sm:inline text-[#E5A823]">&bull;</span>

          <span>Real estate developments</span>
        </div>
      </div>
    </section>
