---
import { MessageSquareText, Menu, X, ArrowUpRight } from "@lucide/astro";
import LogoArdiJaya from "../../src/assets/logo ardi jaya.png"

const navLinks = [
  { label: "Construction", href: "/construction" },
  { label: "Our Work", href: "/portfolio" },
  { label: "Who are we", href: "/about" },
];

const whatsappGeneral =
  "https://wa.me/6282221892050?text=" +
  encodeURIComponent(
    "Halo Ardi Jaya, saya ingin berdiskusi mengenai proyek pembangunan di Bali.",
  );

const whatsappConsultation =
  "https://wa.me/6282221892050?text=" +
  encodeURIComponent(
    "Halo Ardi Jaya, saya ingin konsultasi proyek pembangunan di Bali.",
  );

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 w-full">
  <div
    id="navbar-inner"
    class="bg-gradient-to-b from-black/80 via-black/40 to-transparent py-5 transition-all duration-300"
  >
    <div
      class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex items-center justify-between"
    >
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 hover:opacity-90 transition">
        <img
          src={LogoArdiJaya.src}
          alt="Ardi Jaya Construction Bali"
          class="w-auto h-[58px] sm:h-[62px] object-contain"
        />

        <div>
          <div
            class="text-white font-extrabold text-lg sm:text-xl tracking-[0.2em]"
          >
            ARDI JAYA
          </div>

          <div
            class="text-[9px] font-semibold tracking-[0.25em] text-orange-400"
          >
            BUILDING MATERIAL
          </div>

          <div
            class="text-[9px] font-semibold tracking-[0.25em] text-orange-400"
          >
            EQUIPMENT & CONSTRUCTION
          </div>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav
        class="hidden lg:flex items-center gap-8 text-[13px] uppercase tracking-[0.16em]"
      >
        {
          navLinks.map((link) => {
            const linkPath = link.href.replace(/\/$/, "") || "/";
            const isActive = currentPath === linkPath;

            return (
              <a
                href={link.href}
                class:list={[
                  "relative py-1 text-white/70 hover:text-white transition-colors",

                  // Garis bawah
                  "after:absolute after:left-0 after:-bottom-1 after:h-[1.5px]",
                  "after:w-0 after:transition-all after:duration-300 after:ease-out",

                  // Hover: orange keputihan
                  "after:bg-[#F7B08A] hover:after:w-full",

                  // Active: orange penuh
                  isActive
                    ? "text-white font-semibold after:bg-[#F26522] after:w-full"
                    : "",
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Desktop WhatsApp -->
      <a
        href={whatsappGeneral}
        target="_blank"
        rel="noopener noreferrer"
        id="navbar-wa-button"
        data-wa-tracking="Navbar_Header_Button"
        class="hidden lg:flex items-center gap-2.5 bg-white text-black px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] hover:bg-[#F26522] hover:text-white transition"
      >
        Speak to us
        <ArrowUpRight class="w-3.5 h-3.5" />
      </a>

      <!-- Mobile Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden p-2 text-white"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <Menu id="menu-icon" class="w-6 h-6" />
        <X id="close-icon" class="w-6 h-6 hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-x-0 top-[70px] bg-[#0B0E14] border-b border-white/10 px-6 shadow-2xl
         max-h-0 opacity-0 -translate-y-2 overflow-hidden pointer-events-none
         transition-all duration-300 ease-out py-5"
  >
    <nav class="flex flex-col gap-5 text-sm uppercase tracking-[0.2em]">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link py-2 text-white/90 hover:text-[#F26522] border-b border-white/5"
          >
            {link.label}
          </a>
        ))
      }

      <a
        href={whatsappConsultation}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 flex items-center justify-center gap-2 bg-[#F26522] text-white py-3.5 font-bold"
      >
        <MessageSquareText class="w-4 h-4" />
        Speak to Our Team
      </a>

      <div class="text-[10px] text-center text-slate-400">
        <p>Kantor: Desa Baluk, Jembrana, Bali</p>
        <p>Respon 24 Jam</p>
      </div>
    </nav>
  </div>
</header>

<script>
  function initNavbar() {
    const navbarInner = document.getElementById("navbar-inner");

    const menuButton = document.getElementById("mobile-menu-toggle");

    const mobileMenu = document.getElementById("mobile-menu");

    const menuIcon = document.getElementById("menu-icon");

    const closeIcon = document.getElementById("close-icon");

    if (!navbarInner) return;

    // =========================
    // NAVBAR SCROLL EFFECT
    // =========================

    const updateNavbar = () => {
      const scrolled = window.scrollY > 30;

      navbarInner.classList.toggle("bg-gradient-to-b", !scrolled);
      navbarInner.classList.toggle("from-black/80", !scrolled);
      navbarInner.classList.toggle("via-black/40", !scrolled);
      navbarInner.classList.toggle("to-transparent", !scrolled);
      navbarInner.classList.toggle("py-5", !scrolled);

      navbarInner.classList.toggle("bg-[#0E1116]/95", scrolled);
      navbarInner.classList.toggle("backdrop-blur-md", scrolled);
      navbarInner.classList.toggle("border-b", scrolled);
      navbarInner.classList.toggle("border-white/10", scrolled);
      navbarInner.classList.toggle("py-3.5", scrolled);
      navbarInner.classList.toggle("shadow-2xl", scrolled);
    };

    window.addEventListener("scroll", updateNavbar);

    // Jalankan langsung saat halaman dibuka
    updateNavbar();

    // =========================
    // MOBILE MENU
    // =========================

    const toggleMenu = () => {
      if (!mobileMenu) return;

      const open = mobileMenu.classList.contains("max-h-0");

      mobileMenu.classList.toggle("max-h-0", !open);
      mobileMenu.classList.toggle("max-h-[500px]", open);

      mobileMenu.classList.toggle("opacity-0", !open);
      mobileMenu.classList.toggle("opacity-100", open);

      mobileMenu.classList.toggle("-translate-y-2", !open);
      mobileMenu.classList.toggle("translate-y-0", open);

      mobileMenu.classList.toggle("pointer-events-none", !open);
      mobileMenu.classList.toggle("pointer-events-auto", open);

      menuIcon?.classList.toggle("hidden", open);

      closeIcon?.classList.toggle("hidden", !open);

      menuButton?.setAttribute("aria-expanded", String(open));
    };

    menuButton?.addEventListener("click", toggleMenu);

    // =========================
    // MOBILE NAV LINK
    // =========================

    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu?.classList.add("max-h-0");
        mobileMenu?.classList.remove("max-h-[500px]");

        mobileMenu?.classList.add("opacity-0");
        mobileMenu?.classList.remove("opacity-100");

        mobileMenu?.classList.add("-translate-y-2");
        mobileMenu?.classList.remove("translate-y-0");

        mobileMenu?.classList.add("pointer-events-none");
        mobileMenu?.classList.remove("pointer-events-auto");

        menuIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");

        menuButton?.setAttribute("aria-expanded", "false");
      });
    });

    // =========================
    // WHATSAPP TRACKING
    // =========================

    document
      .querySelector("[data-wa-tracking]")
      ?.addEventListener("click", () => {
        window.dispatchEvent(
          new CustomEvent("whatsapp-click", {
            detail: {
              source: "Navbar_Header_Button",
              label: "Konsultasi Umum WhatsApp",
            },
          }),
        );
      });
  }

  // Initial page + setiap navigasi ClientRouter
  document.addEventListener("astro:page-load", initNavbar);
</script>
