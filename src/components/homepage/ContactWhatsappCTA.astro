---
import GambarCTA from "/src/assets/gambar3.jpeg";
const whatsappUrl =
  "https://wa.me/628XXXXXXXXXX?text=Halo%20Ardi%20Jaya%2C%20saya%20tertarik%20membangun%20villa%20berkualitas%20di%20Bali%20dan%20ingin%20mendapatkan%20penawaran%20%28Get%20a%20Quote%29%20%2F%20konsultasi%20gratis.";
---

<section
  id="kontak"
  class="bg-[#E4E4E6] text-slate-900 border-t border-slate-300"
>
  <!-- Minimalist Top Content -->
  <div
    class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20"
  >
    <div class="max-w-4xl">
      <h2
        class="text-3xl sm:text-5xl lg:text-[54px] font-light tracking-tight text-slate-950 font-sans leading-[1.12]"
      >
        Attention to detail, defines excellence
      </h2>

      <p
        class="text-sm sm:text-base text-slate-700 font-light mt-3 sm:mt-4 mb-8 sm:mb-9 max-w-2xl leading-relaxed"
      >
        Interested in building a top quality villa in Bali? Send us some details
        and we'll set up a free consultation.
      </p>

      <div>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          id="main-contact-wa-button"
          class="group inline-flex items-center gap-3 bg-[#1C1D21] hover:bg-[#F26522] text-white px-7 py-3.5 sm:px-8 sm:py-4 rounded-none text-xs sm:text-sm uppercase font-bold tracking-[0.2em] transition-colors duration-200 shadow-sm"
        >
          <span>GET A QUOTE</span>
          <span
            class="text-base transition-transform duration-200 group-hover:translate-x-1"
          >
            &rarr;
          </span>
        </a>
      </div>
    </div>
  </div>

  <!-- Expansive Architectural Villa Interior Panoramic Banner -->
  <div
    class="relative w-full aspect-[16/9] sm:aspect-[21/9] lg:h-[620px] overflow-hidden bg-slate-300 border-t border-black/5"
  >
    <img
      src={GambarCTA.src}
      alt="Luxury Architectural Villa Interior Bali"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      referrerpolicy="no-referrer"
    />
  </div>
</section>
