---
interface Props {
  title: string;
  category: string;
  mainImage: string;
  gallery: string[];
}

const {
  title,
  category,
  mainImage,
  gallery = [],
} = Astro.props;

const allImages = Array.from(
  new Set([mainImage, ...gallery].filter(Boolean))
);

const total = allImages.length;
const hasMoreThanFour = total > 4;
const hasMoreThanSix = total > 6;

const whatsappNumber = '628xxxxxxxxxx';
---

<div
  class="portfolio-gallery space-y-6"
  data-total={total}
  data-title={title}
  data-category={category}
  data-images={JSON.stringify(allImages)}
>
  <!-- 1. Main Featured Image -->
  <div
    class="gallery-main group relative aspect-[16/10] rounded-2xl overflow-hidden border border-slate-200 shadow-md cursor-pointer bg-slate-900"
    data-index="0"
  >
    <img
      src={allImages[0]}
      alt={`${title} - Foto Utama`}
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      referrerpolicy="no-referrer"
    />

    <div class="absolute bottom-4 right-4 opacity-70 group-hover:opacity-100 transition-opacity pointer-events-none">
      <div class="w-9 h-9 rounded-full bg-black/60 backdrop-blur-md border border-white/20 flex items-center justify-center text-white">
        <!-- Maximize2 -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 3h6v6" />
          <path d="m21 3-7 7" />
          <path d="m3 21 7-7" />
          <path d="M9 21H3v-6" />
        </svg>
      </div>
    </div>
  </div>

  <!-- 2. Additional Gallery -->
  {total > 1 && (
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
            <!-- Layers -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-[#F26522]"
            >
              <path d="m12.83 2.18 8.5 5.11a1 1 0 0 1 0 1.72l-8.5 5.11a1 1 0 0 1-1.66 0l-8.5-5.11a1 1 0 0 1 0-1.72l8.5-5.11a1 1 0 0 1 1.66 0Z" />
              <path d="m2.17 12.83 8.5 5.11a1 1 0 0 0 1.66 0l8.5-5.11" />
              <path d="m2.17 17.83 8.5 5.11a1 1 0 0 0 1.66 0l8.5-5.11" />
            </svg>

            Galeri Foto Konstruksi & Detail Teknis
          </h3>
        </div>

        <button
          type="button"
          class="open-gallery text-xs font-bold text-[#F26522] hover:text-[#d95314] transition-colors flex items-center gap-1"
        >
          <!-- Images -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="18" height="18" x="3" y="3" rx="2" />
            <circle cx="9" cy="9" r="2" />
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
          </svg>

          <span>Buka Galeri ({total})</span>
        </button>
      </div>

      <!-- Gallery Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {allImages.slice(0, 6).map((imgUrl, idx) => {
          const isFourth = idx === 3;
          const isSixth = idx === 5;

          const hideOnMobileTablet =
            idx >= 4 ? 'hidden lg:block' : '';

          return (
            <div
              class={`gallery-item group relative aspect-[4/3] rounded-xl overflow-hidden border border-slate-200 shadow-xs cursor-pointer bg-slate-900 ${hideOnMobileTablet}`}
              data-index={idx}
            >
              <img
                src={imgUrl}
                alt={`${title} - Foto ${idx + 1}`}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                referrerpolicy="no-referrer"
              />

              <!-- Hover Overlay -->
              <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="p-2 rounded-full bg-white/80 backdrop-blur-xs text-slate-900 shadow-md transform translate-y-2 group-hover:translate-y-0 transition-transform">
                  <!-- Maximize2 -->
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 3h6v6" />
                    <path d="m21 3-7 7" />
                    <path d="m3 21 7-7" />
                    <path d="M9 21H3v-6" />
                  </svg>
                </span>
              </div>

              <!-- Mobile / Tablet 4+ -->
              {isFourth && hasMoreThanFour && (
                <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-xs flex flex-col items-center justify-center text-white p-3 text-center border-2 border-orange-500/80 block lg:hidden">
                  <span class="text-2xl sm:text-3xl font-black tracking-wider">
                    4+
                  </span>

                  <span class="text-[11px] font-bold text-orange-400 mt-0.5">
                    +{total - 4} Foto Lainnya
                  </span>

                  <span class="text-[10px] text-white/80 mt-1 uppercase tracking-wider font-semibold">
                    Lihat Semua ({total})
                  </span>
                </div>
              )}

              <!-- Desktop 6+ -->
              {isSixth && hasMoreThanSix && (
                <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-xs flex-col items-center justify-center text-white p-3 text-center border-2 border-orange-500/80 hidden lg:flex">
                  <span class="text-3xl font-black tracking-wider">
                    6+
                  </span>

                  <span class="text-xs font-bold text-orange-400 mt-1">
                    +{total - 6} Foto Lainnya
                  </span>

                  <span class="text-[11px] text-white/80 mt-1 uppercase tracking-wider font-semibold">
                    Lihat Semua ({total})
                  </span>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  )}

  <!-- 3. Lightbox -->
  <div
    class="lightbox fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden flex-col justify-between select-none"
    role="dialog"
    aria-modal="true"
  >
    <!-- Top Control Bar -->
    <div class="flex items-center justify-between px-4 sm:px-8 py-4 border-b border-white/10 bg-black/40">
      <div class="flex items-center gap-3">
        <span class="lightbox-category px-2.5 py-1 rounded-md bg-[#F26522] text-white text-xs font-bold uppercase tracking-wider">
          {category}
        </span>

        <div class="text-white">
          <h4 class="lightbox-title text-xs sm:text-sm font-bold truncate max-w-[200px] sm:max-w-md">
            {title}
          </h4>

          <p class="lightbox-counter text-[11px] text-slate-400">
            Foto 1 dari {total}
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <!-- WhatsApp -->
        <a
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="lightbox-whatsapp hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-colors"
        >
          <!-- MessageSquareText -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
            <path d="M8 9h8" />
            <path d="M8 13h5" />
          </svg>

          <span>Konsultasi Foto Ini via WA</span>
        </a>

        <!-- Close -->
        <button
          type="button"
          class="lightbox-close p-2 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors"
          aria-label="Tutup Galeri (Esc)"
        >
          <!-- X -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Main Slide -->
    <div class="lightbox-content relative flex-1 flex items-center justify-center p-4 sm:p-8 overflow-hidden">

      <!-- Previous -->
      <button
        type="button"
        class="lightbox-prev absolute left-3 sm:left-6 z-20 p-3 sm:p-4 rounded-full bg-black/60 hover:bg-[#F26522] text-white border border-white/20 backdrop-blur-md transition-all duration-200 hover:scale-110 active:scale-95 shadow-xl"
        aria-label="Foto Sebelumnya"
      >
        <!-- ChevronLeft -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>

      <!-- Current Image -->
      <div class="relative w-full h-full max-w-5xl max-h-[75vh] flex items-center justify-center">
        <img
          class="lightbox-image absolute inset-0 w-full h-full object-contain"
          src={allImages[0]}
          alt={`${title} - Slide 1`}
          referrerpolicy="no-referrer"
        />
      </div>

      <!-- Next -->
      <button
        type="button"
        class="lightbox-next absolute right-3 sm:right-6 z-20 p-3 sm:p-4 rounded-full bg-black/60 hover:bg-[#F26522] text-white border border-white/20 backdrop-blur-md transition-all duration-200 hover:scale-110 active:scale-95 shadow-xl"
        aria-label="Foto Selanjutnya"
      >
        <!-- ChevronRight -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>
    </div>

    <!-- Thumbnail Strip -->
    <div class="border-t border-white/10 bg-black/60 px-4 py-3">
      <div class="lightbox-thumbnails flex items-center justify-start sm:justify-center gap-2.5 overflow-x-auto pb-1 scrollbar-none">
        {allImages.map((imgUrl, idx) => (
          <button
            type="button"
            class={`lightbox-thumbnail relative shrink-0 w-14 h-11 sm:w-20 sm:h-14 rounded-lg overflow-hidden border-2 transition-all duration-200 ${
              idx === 0
                ? 'border-[#F26522] scale-105 shadow-md shadow-orange-500/20 opacity-100'
                : 'border-white/20 opacity-50 hover:opacity-80'
            }`}
            data-index={idx}
          >
            <img
              src={imgUrl}
              alt={`Thumbnail ${idx + 1}`}
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover"
              referrerpolicy="no-referrer"
            />
          </button>
        ))}
      </div>

      <div class="text-center mt-2">
        <span class="text-[11px] text-slate-400">
          Gunakan panah kiri/kanan di keyboard atau geser layar untuk navigasi foto
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.portfolio-gallery').forEach((gallery) => {
    const images = JSON.parse(
      gallery.getAttribute('data-images') || '[]'
    );

    const title =
      gallery.getAttribute('data-title') || '';

    const category =
      gallery.getAttribute('data-category') || '';

    const total = images.length;

    const lightbox =
      gallery.querySelector('.lightbox');

    const mainImage =
      gallery.querySelector('.gallery-main');

    const galleryItems =
      gallery.querySelectorAll('.gallery-item');

    const openGalleryButton =
      gallery.querySelector('.open-gallery');

    const closeButton =
      gallery.querySelector('.lightbox-close');

    const prevButton =
      gallery.querySelector('.lightbox-prev');

    const nextButton =
      gallery.querySelector('.lightbox-next');

    const lightboxImage =
      gallery.querySelector('.lightbox-image');

    const counter =
      gallery.querySelector('.lightbox-counter');

    const thumbnails =
      gallery.querySelectorAll('.lightbox-thumbnail');

    const thumbnailContainer =
      gallery.querySelector('.lightbox-thumbnails');

    const whatsappLink =
      gallery.querySelector('.lightbox-whatsapp');

    let currentIndex = 0;
    let touchStartX = null;

    const whatsappNumber = '{$whatsappNumber}';

    function updateSlide(index) {
      if (!images.length) return;

      currentIndex =
        (index + total) % total;

      lightboxImage.src =
        images[currentIndex];

      lightboxImage.alt =
        `${title} - Slide ${currentIndex + 1}`;

      counter.textContent =
        `Foto ${currentIndex + 1} dari ${total}`;

      const message =
        `Halo Ardi Jaya, saya sedang melihat foto ke-${currentIndex + 1} pada proyek "${title}". Saya ingin berkonsultasi mengenai spesifikasi bangunan ini.`;

      whatsappLink.href =
        `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

      thumbnails.forEach((thumbnail, index) => {
        if (index === currentIndex) {
          thumbnail.classList.remove(
            'border-white/20',
            'opacity-50'
          );

          thumbnail.classList.add(
            'border-[#F26522]',
            'scale-105',
            'shadow-md',
            'shadow-orange-500/20',
            'opacity-100'
          );
        } else {
          thumbnail.classList.remove(
            'border-[#F26522]',
            'scale-105',
            'shadow-md',
            'shadow-orange-500/20',
            'opacity-100'
          );

          thumbnail.classList.add(
            'border-white/20',
            'opacity-50'
          );
        }
      });

      const activeThumbnail =
        thumbnails[currentIndex];

      if (activeThumbnail) {
        activeThumbnail.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
          inline: 'center',
        });
      }
    }

    function openLightbox(index = 0) {
      currentIndex = index;

      updateSlide(currentIndex);

      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');

      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');

      document.body.style.overflow = '';
    }

    function nextSlide() {
      updateSlide(currentIndex + 1);
    }

    function prevSlide() {
      updateSlide(currentIndex - 1);
    }

    mainImage?.addEventListener('click', () => {
      openLightbox(0);
    });

    galleryItems.forEach((item) => {
      item.addEventListener('click', () => {
        const index =
          Number(item.getAttribute('data-index'));

        openLightbox(index);
      });
    });

    openGalleryButton?.addEventListener(
      'click',
      () => openLightbox(0)
    );

    closeButton?.addEventListener(
      'click',
      closeLightbox
    );

    prevButton?.addEventListener(
      'click',
      prevSlide
    );

    nextButton?.addEventListener(
      'click',
      nextSlide
    );

    thumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener('click', () => {
        const index =
          Number(thumbnail.getAttribute('data-index'));

        updateSlide(index);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (lightbox.classList.contains('hidden')) {
        return;
      }

      if (event.key === 'Escape') {
        closeLightbox();
      }

      if (event.key === 'ArrowRight') {
        nextSlide();
      }

      if (event.key === 'ArrowLeft') {
        prevSlide();
      }
    });

    lightbox?.addEventListener(
      'touchstart',
      (event) => {
        touchStartX =
          event.touches[0].clientX;
      },
      { passive: true }
    );

    lightbox?.addEventListener(
      'touchend',
      (event) => {
        if (touchStartX === null) {
          return;
        }

        const touchEndX =
          event.changedTouches[0].clientX;

        const diff =
          touchStartX - touchEndX;

        if (diff > 50) {
          nextSlide();
        } else if (diff < -50) {
          prevSlide();
        }

        touchStartX = null;
      },
      { passive: true }
    );

    // Klik area hitam di luar gambar untuk menutup
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });
  });
</script>